# Required to run the mission team assessment.
OPENAI_API_KEY=

# Agent runtime profiles. Restart the server after changing these values.
MISSION_DIRECTOR_MODEL=gpt-5.6-sol
MISSION_DIRECTOR_REASONING_EFFORT=high
NOVA_MODEL=gpt-5.6-terra
NOVA_REASONING_EFFORT=medium
AURA_MODEL=gpt-5.6-terra
AURA_REASONING_EFFORT=medium
KEPLER_MODEL=gpt-5.6-luna
KEPLER_REASONING_EFFORT=low
MERCURY_MODEL=gpt-5.6-sol
MERCURY_REASONING_EFFORT=high

# Optional Arize Phoenix tracing.
PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=mars-mission-control
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
