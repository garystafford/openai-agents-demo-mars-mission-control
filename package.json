{
  "name": "mars-mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@arizeai/openinference-instrumentation-openai-agents": "^0.2.6",
    "@arizeai/phoenix-otel": "^2.2.0",
    "@openai/agents": "latest",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
